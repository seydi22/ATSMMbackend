NODE_ENV=development
HOST=0.0.0.0
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ats_portal
JWT_SECRET=changez-moi-en-production
OPERATOR_USERNAME=admin
OPERATOR_PASSWORD=admin123
FRONTEND_ORIGIN=*
# SERVE_FRONTEND=true

# Contrôle doublons à l'import (false = réactiver après régularisation)
SKIP_DUPLICATE_CHECK=true
# Seuil RTGS dans le XML (montant total du fichier >= seuil → RTGS au lieu de ACH)
RTGS_THRESHOLD=1000000

# Brevo SMTP — https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre_login_smtp_brevo
SMTP_PASS=votre_cle_smtp_brevo
SMTP_FROM="ATS Portal <expediteur-verifie@votre-domaine.com>"
